# Copy to server/.env and fill in.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: model & effort tiering (defaults shown) ---------------------
# Research is agentic/tool-heavy → Opus. Synthesis & chat default to the
# cheaper, fast Sonnet 4.6. Override any of these to trade cost vs. quality.
# RESEARCH_MODEL=claude-opus-4-8
# SYNTHESIS_MODEL=claude-sonnet-4-6
# CHAT_MODEL=claude-sonnet-4-6
# RESEARCH_EFFORT=high       # low | medium | high
# SYNTHESIS_EFFORT=medium
# CHAT_EFFORT=medium
